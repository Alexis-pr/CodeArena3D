# Variables de entorno para CodeArena 3D en Docker Compose

# Conexión directa a Supabase PostgreSQL (Session Mode en puerto 5432)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Clave de API de Google Gemini para generación de preguntas técnicas dinámicas
GEMINI_API_KEY=tu_api_key_aqui

# URL del Frontend permitida para CORS
FRONTEND_URL=http://codearena3d.duckdns.org:8080
