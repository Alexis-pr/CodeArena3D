PORT=3000

# Conexión directa a Supabase en puerto 5432 (Session Mode para SELECT ... FOR UPDATE)
# Reemplaza [PASSWORD] y [PROJECT_REF] con tus credenciales de Supabase
DATABASE_URL=postgresql://postgres:[TU_PASSWORD]@db.[TU_PROJECT_REF].supabase.co:5432/postgres

# API Key de Gemini para generación de preguntas con IA (modo estructurado)
GEMINI_API_KEY=tu_api_key_aqui
